diff --git a/core/java/android/view/EinkRefresh.java b/core/java/android/view/EinkRefresh.java
new file mode 100644
index 000000000..f1fb4cb42
--- /dev/null
+++ b/core/java/android/view/EinkRefresh.java
@@ -0,0 +1,46 @@
+package android.view;
+
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+
+final class EinkRefresh {
+    private static final String SERVICE = "eink_refresh";
+    private static final int UPDATE_FULL = 32;
+    private static final int WAVEFORM_MASK = 15;
+    private static final int WAVEFORM_GC16 = 2;
+
+    private static IEinkRefresh sService;
+
+    private EinkRefresh() {
+    }
+
+    static void request(int mode) {
+        if ((mode & UPDATE_FULL) == 0 && (mode & WAVEFORM_MASK) != WAVEFORM_GC16) {
+            return;
+        }
+        IEinkRefresh service = service();
+        if (service == null) {
+            return;
+        }
+        try {
+            service.flash();
+        } catch (RemoteException e) {
+            forget();
+        }
+    }
+
+    private static synchronized IEinkRefresh service() {
+        if (sService == null) {
+            IBinder binder = ServiceManager.checkService(SERVICE);
+            if (binder != null) {
+                sService = IEinkRefresh.Stub.asInterface(binder);
+            }
+        }
+        return sService;
+    }
+
+    private static synchronized void forget() {
+        sService = null;
+    }
+}
diff --git a/core/java/android/view/IEinkRefresh.aidl b/core/java/android/view/IEinkRefresh.aidl
new file mode 100644
index 000000000..45581d0a7
--- /dev/null
