diff --git a/services/core/java/com/android/server/eink/EinkRefreshService.java b/services/core/java/com/android/server/eink/EinkRefreshService.java
new file mode 100644
index 000000000..22a615644
--- /dev/null
+++ b/services/core/java/com/android/server/eink/EinkRefreshService.java
@@ -0,0 +1,43 @@
+package com.android.server.eink;
+
+import android.content.Context;
+import android.util.Slog;
+import android.view.IEinkRefresh;
+
+import com.android.server.SystemService;
+
+import java.io.FileOutputStream;
+import java.io.IOException;
+
+public final class EinkRefreshService extends SystemService {
+    private static final String TAG = "EinkRefreshService";
+    private static final String SERVICE = "eink_refresh";
+    private static final String NODE = "/sys/devices/virtual/sepdc/debug/ui_flash";
+
+    private boolean mWarned;
+
+    public EinkRefreshService(Context context) {
+        super(context);
+    }
+
+    @Override
+    public void onStart() {
+        publishBinderService(SERVICE, new IEinkRefresh.Stub() {
+            @Override
+            public void flash() {
+                write();
+            }
+        });
+    }
+
+    private synchronized void write() {
+        try (FileOutputStream out = new FileOutputStream(NODE)) {
+            out.write('1');
+        } catch (IOException e) {
+            if (!mWarned) {
+                mWarned = true;
+                Slog.w(TAG, "cannot write " + NODE, e);
+            }
+        }
+    }
+}
