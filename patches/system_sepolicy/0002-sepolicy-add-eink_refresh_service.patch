From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Go7 port <go7-port@example.invalid>
Date: Wed, 25 Nov 2026 20:00:00 +0000
Subject: [PATCH] sepolicy: add eink_refresh_service

system_server publishes eink_refresh, which apps reach through the
hidden View.refreshScreen to request a full e-ink refresh (the matching
frameworks/base patch). A private app_api_service type: apps find it
and system_server adds it with the existing rules, and private types
need no prebuilts/api or compat entries. fuzzer_bindings_test requires
every service_contexts name in service_fuzzer_bindings.go.
---
 build/soong/service_fuzzer_bindings.go | 1 +
 private/service.te                     | 1 +
 private/service_contexts               | 1 +
 3 files changed, 3 insertions(+)

diff --git a/build/soong/service_fuzzer_bindings.go b/build/soong/service_fuzzer_bindings.go
index dd83ae0..5f1b517 100644
--- a/build/soong/service_fuzzer_bindings.go
+++ b/build/soong/service_fuzzer_bindings.go
@@ -322,6 +322,7 @@ var (
 		"dynamic_instrumentation":                                              EXCEPTION_NO_FUZZER,
 		"econtroller":                                                          EXCEPTION_NO_FUZZER,
 		"ecm_enhanced_confirmation":                                            EXCEPTION_NO_FUZZER,
+		"eink_refresh":                                                         EXCEPTION_NO_FUZZER,
 		"emergency_affordance":                                                 EXCEPTION_NO_FUZZER,
 		"euicc_card_controller":                                                EXCEPTION_NO_FUZZER,
 		"external_vibrator_service":                                            EXCEPTION_NO_FUZZER,
diff --git a/private/service.te b/private/service.te
index 7e738f8..399cc78 100644
--- a/private/service.te
+++ b/private/service.te
@@ -14,6 +14,7 @@ type communal_service,               app_api_service, system_server_service, ser
 type content_restriction_service,    app_api_service, ephemeral_app_api_service, system_server_service, service_manager_type;
 type d2d_connectivity_service,       system_api_service, system_server_service, service_manager_type;
 type dynamic_system_service,         system_api_service, system_server_service, service_manager_type;
+type eink_refresh_service,           app_api_service, system_server_service, service_manager_type;
 type feature_flags_service,          app_api_service, system_server_service, service_manager_type;
 type file_service,                   app_api_service, ephemeral_app_api_service, system_server_service, service_manager_type;
 type fwk_devicestate_service, system_server_service, service_manager_type;
diff --git a/private/service_contexts b/private/service_contexts
index de00043..732fe0b 100644
--- a/private/service_contexts
+++ b/private/service_contexts
@@ -312,6 +312,7 @@ dumpstate                                 u:object_r:dumpstate_service:s0
 dynamic_system                            u:object_r:dynamic_system_service:s0
 econtroller                               u:object_r:radio_service:s0
 ecm_enhanced_confirmation                 u:object_r:ecm_enhanced_confirmation_service:s0
+eink_refresh                              u:object_r:eink_refresh_service:s0
 emergency_affordance                      u:object_r:emergency_affordance_service:s0
 euicc_card_controller                     u:object_r:radio_service:s0
 external_vibrator_service                 u:object_r:external_vibrator_service:s0
-- 
